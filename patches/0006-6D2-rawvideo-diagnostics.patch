+/* frame timing measured from the VIDF timestamps, used to stamp the MLVI header.
+ * Written by the vsync hook, read by RawRecTask when finishing a chunk;
+ * deliberately unguarded, as a torn read only skews the fps estimate slightly. */
+static uint64_t vidf_ts_first = 0;      /* first VIDF timestamp, us since rec start */
+static uint64_t vidf_ts_last  = 0;      /* most recent VIDF timestamp */
+static int      vidf_ts_count = 0;      /* how many VIDF timestamps we stamped */
        GUARDED_BY(RawRecTask)   uint32_t raw_rec_trace_ctx = TRACE_ERROR;
 
+/* spike 006 rev 3: mirror a diagnostic line to the console *and* to the card,
+ * so the owner no longer has to photograph the 21-line ML console.
+ * Only called from task context (raw_rec_polling_cbr), never from an ISR - FIO is legal here.
+ * Deliberately duplicated from src/exmem.c rather than exported: a new core symbol
+ * would need .sym plumbing for one 12-line helper. */
+static void diag_log(const char *fmt, ...)
+{
+    char buf[128];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(buf, sizeof(buf) - 1, fmt, ap);
+    va_end(ap);
+
+    printf("%s", buf);
+
+    FILE *f = FIO_CreateFileOrAppend("ML/LOGS/RAWDIAG.LOG");
+    if (f)
+    {
+        char ts[16];
+        int ms = get_ms_clock();
+        snprintf(ts, sizeof(ts), "[%d.%03d] ", ms / 1000, ms % 1000);
+        FIO_WriteFile(f, ts, strlen(ts));
+        FIO_WriteFile(f, buf, strlen(buf));
+        FIO_CloseFile(f);
+    }
+}
