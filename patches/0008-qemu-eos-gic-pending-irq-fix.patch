+/* Pending SGI per GIC CPU interface, 0x20 = none (0x20/0x21 are the two
+ * device-interrupt SPIs, so they can never be an SGI id).  File scope because
+ * both the GIC handler and the device-interrupt path share one CPU_INTERRUPT_HARD
+ * line per core and must agree on when to drop it. */
+static int gic_sgi_pending[2] = {0x20, 0x20};
+
+/* The IRQ line of a core is the OR of a latched device interrupt (irq_id) and
+ * a pending SGI.  Acking one must not drop the other -- that wedge is what
+ * patches/0008 papered over with a re-assert.  All callers hold the BQL. */
+static void eos_update_irq_line(int bank)
+{
+    ARMCPU *cpu = eos_state->cpus[bank];
+    if (!cpu) return;
+
+    if (eos_state->irq_id[bank] || gic_sgi_pending[bank] != 0x20) {
+        cpu_interrupt(CPU(cpu), CPU_INTERRUPT_HARD);
+    } else {
+        cpu_reset_interrupt(CPU(cpu), CPU_INTERRUPT_HARD);
+    }
+}
+
+/* Is `id` armed on any core? */
+static int eos_int_armed(unsigned int id)
+{
+    return eos_state->irq_enabled[0][id] ||
+           (eos_state->cpu1 && eos_state->irq_enabled[1][id]);
+}
+
+/* Latch `id` in the reason register of every bank that has it armed and is not
+ * already servicing something, and raise those cores' IRQ lines.  This replaces
+ * "deliver to whichever vCPU happens to be executing".  Returns the number of
+ * cores reached; 0 means the caller must schedule it for later.
+ * ponytail: a bank that is busy right now simply misses this edge instead of
+ * getting its own pending queue - the guest re-arms periodic sources anyway.
+ * Give each bank its own irq_schedule[] if a level-sensitive source shows up. */
+static int eos_deliver_int(unsigned int id)
+{
+    int delivered = 0;
+
+    for (int bank = 0; bank < 2; bank++)
+    {
+        if (!eos_state->cpus[bank]) continue;
+        if (!eos_state->irq_enabled[bank][id]) continue;
+        if (eos_state->irq_id[bank]) continue;
+
+        eos_state->irq_id[bank] = id;
+        /* DryOS re-arms the interrupt inside the handler (bank+0x1010) */
+        eos_state->irq_enabled[bank][id] = 0;
+        eos_update_irq_line(bank);
+        delivered++;
+    }
+
+    return delivered;
+}
 
