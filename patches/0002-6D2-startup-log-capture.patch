     qprintf("Logging buffer: %X - %X\n", buf, buf + buf_size - 1);
     qprintf("Free memory: %X\n", GetFreeMemForAllocateMemory());
+#ifdef CONFIG_STARTUP_LOG
+    if (!buf)
