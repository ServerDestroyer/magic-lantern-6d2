@@ -368,6 +445,28 @@ void log_finish()
     DryosDebugMsg(0, 15, "Logging finished.");
     DryosDebugMsg(0, 15, "Free memory: %d bytes.", GetFreeMemForAllocateMemory());
 
+#ifdef CONFIG_STARTUP_LOG
+    /* Append the diagnostics straight into the buffer, deliberately NOT via
+     * DebugMsg: interception is the thing under test, so it cannot be trusted
+     * to record its own failure. Distinguishes "hook stopped being called"
+     * (entered stays at the line count) from "hook ran but dropped the message"
+     * (drop_nobuf / drop_full climb) and from a stuck lock (enter != exit). */
+    if (buf && buf_size - len > 300)
+    {
+        uint32_t dbg = (uint32_t) &DryosDebugMsg & ~1;
+        len += snprintf(buf + len, buf_size - len,
+            "\n*** DIAG entered=%d appended=%d drop_nobuf=%d drop_full=%d "
+            "lock_enter=%d lock_exit=%d irq_enabled=%d len=%d buf=%x buf_size=%d\n"
+            "*** DIAG dbg_addr=%x now=[%08x %08x %08x] want=[c004f8df bf004760 x] "
+            "my_DebugMsg=%x pre_isr_hook=%x post_isr_hook=%x\n",
+            diag_entered, diag_appended, diag_drop_nobuf, diag_drop_full,
+            diag_lock_enter, diag_lock_exit, diag_irq_enabled,
+            len, (uint32_t) buf, buf_size,
+            dbg, MEM(dbg), MEM(dbg + 4), MEM(dbg + 8),
+            (uint32_t) &my_DebugMsg, (uint32_t) pre_isr_hook, (uint32_t) post_isr_hook);
+    }
+#endif
+
     qprintf("Saving log %X size %X...\n", buf, len);
     sync_caches();
     dump_file("DEBUGMSG.LOG", (uint32_t) buf, len);
