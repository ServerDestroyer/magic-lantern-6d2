+#ifdef CONFIG_STARTUP_LOG
+/* diagnostics for the "capture stops early" investigation: these are updated
+ * without touching DebugMsg, so they stay valid even if interception dies */
+static volatile int diag_entered;       /* my_DebugMsg reached at all */
+static volatile int diag_drop_nobuf;    /* returned: buf == NULL */
+static volatile int diag_drop_full;     /* returned: buffer considered full */
+static volatile int diag_appended;      /* made it past both guards */
+static volatile int diag_lock_enter;    /* about to take the spin lock */
+static volatile int diag_lock_exit;     /* released it again (enter != exit => stuck) */
+static volatile int diag_irq_enabled;   /* entered with interrupts still on */
+static volatile int diag_free_before;   /* allocator pool, sampled around the */
+static volatile int diag_free_after;    /* buffer allocation: if free does not */
+static volatile int diag_total_before;  /* drop by buf_size, we did not get it */
+static volatile int diag_total_after;
+#define DIAG(x) do { (x)++; } while (0)
+#else
+#define DIAG(x) do { } while (0)
+#endif
+
 /* override Canon's DebugMsg to save all messages */
 /* DIGIC 7/8: this runs on both CPU cores */
 static void my_DebugMsg(int class, int level, char* fmt, ...)
 {
     uintptr_t lr = read_lr();
 
+    DIAG(diag_entered);
+
     if (!buf)
+    {
+        DIAG(diag_drop_nobuf);
         return;
+    }
     if (buf_size - len < 100)
+    {
+        DIAG(diag_drop_full);
         return;
+    }
+    DIAG(diag_appended);
 
 #if 0
     if ((class != 0 || level != 15) && level < 3)
@@ -40,6 +68,7 @@ static void my_DebugMsg(int class, int level, char* fmt, ...)
     }
 #endif
 
+    DIAG(diag_lock_enter);
 #if defined(CONFIG_DIGIC_78X)
     static volatile uint32_t lock;
     uint32_t old = cli_spin_lock(&lock);
@@ -47,11 +76,22 @@ static void my_DebugMsg(int class, int level, char* fmt, ...)
     uint32_t old = cli();
 #endif
 
-    /* are the interrupts actually disabled? */
+    /* Are the interrupts actually disabled?
+     * NOTE: 80 is decimal = 0x50, which overlaps CPSR M[4] (set in every
+     * AArch32 mode), so this test can never fire — it is dead as written.
+     * Deliberately left as upstream has it: correcting it to 0x80 makes the
+     * check live, and a live check here starts dropping messages. The only
+     * change is that the failure path no longer spins forever, which would be
