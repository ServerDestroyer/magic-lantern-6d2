diff --git a/platform/6D2.111/Makefile b/platform/6D2.111/Makefile
index dc7361d39..534e28f95 100644
--- a/platform/6D2.111/Makefile
+++ b/platform/6D2.111/Makefile
@@ -22,5 +22,14 @@ CFLAGS_PLATFORM += -mthumb -mlong-calls
 ML_BOOT_OBJ = boot-d678.o
 ML_SRC_EXTRA_OBJS += $(BUILD_DIR)/function_overrides.o
 
+# Startup-log build for MPU spell capture (qemu-eos) and boot diagnostics.
+# Build with:  make CONFIG_STARTUP_LOG=y
+# Hooks DryosDebugMsg + MPU send/recv ring buffers from boot_post_init_task,
+# saves DEBUGMSG.LOG to card ~20s after boot. See src/log-d678.c.
+ifeq ($(CONFIG_STARTUP_LOG),y)
+ML_SRC_EXTRA_OBJS += $(BUILD_DIR)/log-d678.o
+CFLAGS_PLATFORM += -DCONFIG_STARTUP_LOG
+endif
+
 include ../Makefile
 .DEFAULT_GOAL := $(BUILD_DIR)/cam_complete
diff --git a/src/init.c b/src/init.c
index 628b4b9b0..dae1a8e31 100755
--- a/src/init.c
+++ b/src/init.c
@@ -641,9 +641,25 @@ void boot_pre_init_task()
 #endif
 }
 
+#ifdef CONFIG_STARTUP_LOG
+/* startup-log capture (log-d678.c): dump the log to card after Canon's
+ * startup MPU property exchange has completed */
+static void startup_log_dump_task()
+{
+    extern void log_finish();
+    msleep(20000);
+    log_finish();
+}
+#endif
+
 /* called right after Canon's init_task, while their initialization continues in background */
 void boot_post_init_task(void)
 {
+#ifdef CONFIG_STARTUP_LOG
+    extern void log_start();
+    log_start();
+    task_create("log_dump", 0x1e, 0x1000, startup_log_dump_task, 0);
+#endif
 #if defined(CONFIG_PLATFORM_POST_INIT)
     platform_post_init();
 #endif
